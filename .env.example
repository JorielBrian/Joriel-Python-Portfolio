# Get this from your Neon project dashboard -> Connection string (use the "pooled connection" one for deploys)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Comma-separated. Add your local dev URL and your Vercel domain(s).
CORS_ORIGINS=http://localhost:3000,https://jorielbriansudario.vercel.app

# Any long random string. Sent as the X-Admin-Key header for write requests until
# Phase 2 adds real dashboard auth.
ADMIN_API_KEY=change-me-to-something-long-and-random

# Separate long random string, used to sign login session cookies (Phase 2 auth).
# Do not reuse ADMIN_API_KEY here.
JWT_SECRET=change-me-to-a-different-long-random-string

# Set to "development" locally so session cookies work over plain HTTP
# (SameSite=Lax, no Secure flag). Leave unset (defaults to production behavior:
# SameSite=None + Secure, required for the cross-site Vercel <-> Render cookie).
ENVIRONMENT=development
